# ============================================================
# ELEVATE — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to source control.
# ============================================================

# Database
DATABASE_URL="mysql://root:password@localhost:3306/elevate"

# Authentication & Secrets
JWT_SECRET="your-jwt-secret-min-32-chars-here"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars-here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
TOTP_ENCRYPTION_KEY="your-32-byte-aes-totp-encryption-key"

# Server & Client
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Google OAuth / Google Identity Services (GIS)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Apple Sign-In
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
VITE_APPLE_CLIENT_ID=

# Microsoft Sign-In
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_SECRET=
VITE_MICROSOFT_CLIENT_ID=

# Twilio Verify v2 (SMS Mobile OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Email (SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ELEVATE <noreply@elevate.local>"

# File Uploads
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Session & Cookies
SESSION_SECRET="your-session-secret-here"
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
