# ============================================================
# ELEVATE — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to source control.
# ============================================================

# Database
DATABASE_URL="mysql://root:password@localhost:3306/elevate"

# Authentication
JWT_SECRET="your-jwt-secret-min-32-chars-here"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars-here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Email (configure for production)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@elevate.com

# File Uploads
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Session
SESSION_SECRET="your-session-secret-here"
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
